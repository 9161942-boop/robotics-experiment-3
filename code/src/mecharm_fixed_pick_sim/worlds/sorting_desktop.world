<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sorting_desktop_world">
    <physics name="sorting_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>30.0</update_rate>
    </plugin>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="sorting_table">
      <static>true</static>
      <pose>0.20 0.00 -0.02 0 0 0</pose>
      <link name="table_link">
        <visual name="table_visual">
          <geometry><box><size>0.72 0.52 0.04</size></box></geometry>
          <material><ambient>0.38 0.40 0.43 1</ambient><diffuse>0.38 0.40 0.43 1</diffuse></material>
        </visual>
        <collision name="table_collision"><geometry><box><size>0.72 0.52 0.04</size></box></geometry></collision>
      </link>
    </model>

    <!-- Colored destination pads. They are deliberately simple, solid pads so the first
         experiment can validate arm motion before adding bin-wall collision geometry. -->
    <model name="red_sort_bin">
      <static>true</static><pose>0.14 -0.12 0 0 0 0</pose>
      <link name="bin_link">
        <visual name="bin_visual"><geometry><box><size>0.12 0.18 0.002</size></box></geometry><material><ambient>0.70 0.08 0.06 1</ambient><diffuse>0.70 0.08 0.06 1</diffuse></material></visual>
        <collision name="bin_collision"><geometry><box><size>0.12 0.18 0.002</size></box></geometry></collision>
      </link>
    </model>
    <model name="blue_sort_bin">
      <static>true</static><pose>0.26 -0.12 0 0 0 0</pose>
      <link name="bin_link">
        <visual name="bin_visual"><geometry><box><size>0.12 0.18 0.002</size></box></geometry><material><ambient>0.05 0.16 0.72 1</ambient><diffuse>0.05 0.16 0.72 1</diffuse></material></visual>
        <collision name="bin_collision"><geometry><box><size>0.12 0.18 0.002</size></box></geometry></collision>
      </link>
    </model>
    <model name="green_sort_bin">
      <static>true</static><pose>0.38 -0.12 0 0 0 0</pose>
      <link name="bin_link">
        <visual name="bin_visual"><geometry><box><size>0.12 0.18 0.002</size></box></geometry><material><ambient>0.08 0.65 0.16 1</ambient><diffuse>0.08 0.65 0.16 1</diffuse></material></visual>
        <collision name="bin_collision"><geometry><box><size>0.12 0.18 0.002</size></box></geometry></collision>
      </link>
    </model>

    <!-- Six-object pickup grid: the first four calibrated positions plus two reachable green positions. -->
    <model name="object_red_1"><static>false</static><pose>0.24 0.12 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
        <visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.85 0.10 0.07 1</ambient><diffuse>0.85 0.10 0.07 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact></surface></collision>
      </link>
      <plugin name="sorting_class" filename="libgazebo_ros_p3d.so"><ros><namespace>/sorting/object_red_1</namespace></ros><body_name>object_link</body_name><frame_name>world</frame_name><topic_name>pose</topic_name><update_rate>10</update_rate></plugin>
    </model>
    <model name="object_blue_1"><static>false</static><pose>0.30 0.12 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
        <visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.05 0.18 0.85 1</ambient><diffuse>0.05 0.18 0.85 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
    </model>
    <model name="object_red_3"><static>false</static><pose>0.24 0.18 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial><visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.85 0.10 0.07 1</ambient><diffuse>0.85 0.10 0.07 1</diffuse></material></visual><collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry></collision></link>
    </model>
    <model name="object_blue_2"><static>false</static><pose>0.30 0.18 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial><visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.05 0.18 0.85 1</ambient><diffuse>0.05 0.18 0.85 1</diffuse></material></visual><collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry></collision></link>
    </model>
    <!-- Two additional green objects use the reachable third pickup column. -->
    <model name="object_green_1"><static>false</static><pose>0.24 0.24 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
        <visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.08 0.75 0.18 1</ambient><diffuse>0.08 0.75 0.18 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
    </model>
    <model name="object_green_2"><static>false</static><pose>0.30 0.24 0.0275 0 0 0</pose>
      <link name="object_link"><kinematic>true</kinematic><gravity>false</gravity><inertial><mass>0.04</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
        <visual name="object_visual"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><material><ambient>0.08 0.75 0.18 1</ambient><diffuse>0.08 0.75 0.18 1</diffuse></material></visual>
        <collision name="object_collision"><geometry><cylinder><radius>0.022</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      </link>
    </model>

    <model name="sorting_camera">
      <static>true</static><pose>0.20 0.00 0.90 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="overhead_camera" type="camera">
          <always_on>true</always_on><update_rate>15</update_rate><visualize>true</visualize>
          <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.02</near><far>3.0</far></clip></camera>
          <plugin name="sorting_camera_ros" filename="libgazebo_ros_camera.so"><ros><namespace>/sorting_camera</namespace><argument>use_sim_time:=true</argument></ros><camera_name>overhead</camera_name><frame_name>sorting_camera_link</frame_name><image_topic_name>image_raw</image_topic_name><camera_info_topic_name>camera_info</camera_info_topic_name></plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
